{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telegram-briefing.local/schemas/briefing-item.schema.json",
  "title": "Generated Briefing Item",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "metric", "facts", "sources", "notes", "opinion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "region": { "enum": ["us", "kr", "cn", "jp"] },
    "cat": { "enum": ["rate", "fx", "stock", "corp"] },
    "imp": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tag": { "type": "string", "minLength": 1 },
    "short": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "metric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["value", "dir", "sub"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "dir": { "enum": ["up", "down", "flat"] },
        "sub": { "type": "string", "minLength": 1 }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "note": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+/[0-9]+$" }
    },
    "terms": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["id", "name", "full", "desc"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "full": { "type": "string", "minLength": 1 },
              "desc": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "opinion": { "type": "string", "minLength": 1 }
  }
}
